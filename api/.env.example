MONGO=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_KEY=<any long random string>
PORT=8800
# optional: user id that always gets admin rights
ADMIN_ID=
# comma separated list of frontend URLs allowed to call the API
CLIENT_URL=http://localhost:5173
# set to "production" when deployed (enables cross-site secure cookies)
NODE_ENV=development
